import sqlite3
conexion = sqlite3.connect("Cuentas.db")
conexion.execute("PRAGMA foreign_keys = ON")
cursor = conexion.cursor()
credenciales = [
    (1, 1, 'CS-101', '2026-11-09'),
    (2, 2, 'CS-102', '2026-11-09'),
    (3, 3, 'CS-103', '2026-11-09'),
    (4, 4, 'CS-104', '2026-11-09')
]
cursor.executemany("""
INSERT OR IGNORE INTO Credencial VALUES (?, ?, ?, ?)
""", credenciales)
conexion.commit()

cursor.execute("""
SELECT Usuarios.cuenta, Credencial.codigo_credencial
FROM Usuarios, Credencial
WHERE Usuarios.id_Usuarios = Credencial.id_Usuarios
""")
print("\nUsuarios Y CREDENCIALES")
for registro in cursor.fetchall():
    print(registro)
conexion.close()
